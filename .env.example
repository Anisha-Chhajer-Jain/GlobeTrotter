# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# PostgreSQL connection string. `docker-compose up -d` starts a matching local instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/globetrotter?schema=public"

# Next Auth — generate a real secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable the provider)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin dashboard access
# ADMIN_EMAILS is the real, server-enforced authorization boundary (checked in src/lib/admin.ts).
# NEXT_PUBLIC_ADMIN_EMAILS is only used client-side for an instant redirect — keep both in sync.
ADMIN_EMAILS="john@globetrotter.dev"
NEXT_PUBLIC_ADMIN_EMAILS="john@globetrotter.dev"

# CORS allowlist for production (comma-separated origins). Ignored in development (wildcard allowed there).
ALLOWED_ORIGINS=""

# External Travel & Places APIs (OpenTripMap & RapidAPI)
OPENTRIPMAP_API_KEY=""
RAPIDAPI_KEY=""

